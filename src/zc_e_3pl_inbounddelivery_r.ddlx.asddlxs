@Metadata.layer: #CORE

@UI.headerInfo: { typeName: '3PL Inbound Delivery',
                  typeNamePlural: '3PL Inbound Deliveries',
                  title: { type: #STANDARD, value: 'InboundDelivery' } }

@UI.presentationVariant: [ { visualizations: [ { type: #AS_LINEITEM } ] } ]
annotate entity ZC_3PL_InboundDelivery_R
    with
{
  @Consumption.semanticObject: 'InboundDelivery'
  @UI.facet: [ { id: 'InboundDelivery',
                 purpose: #STANDARD,
                 label: 'Inbound Delivery',
                 position: 10,
                 type: #IDENTIFICATION_REFERENCE } ]
  @UI.lineItem: [ { position: 10, importance: #HIGH },
                  { type: #FOR_INTENT_BASED_NAVIGATION,
                    label: 'Display document',
                    semanticObjectAction: 'displayFactSheet' },
                  { type: #FOR_ACTION, dataAction: 'closeDelivery',
                    label: 'Close 3PL Inbound Delivery',
                    //invocationGrouping: #CHANGE_SET,
                    iconUrl: 'sap-icon://reset' } ]
  @UI.selectionField: [ { position: 10 } ]
  @UI.identification: [ { position: 10 } ]
  InboundDelivery;

  @UI.lineItem: [ { position: 20 } ]
  @UI.selectionField: [ { position: 20 } ]
  @UI.identification: [ { position: 20 } ]
  DeliveryDocumentType;

  @UI.lineItem: [ { position: 15 } ]
  @UI.selectionField: [ { position: 15 } ]
  @UI.identification: [ { position: 15 } ]
  DistrStatusByDecentralizedWrhs;

  @UI.lineItem: [ { position: 30 } ]
  @UI.selectionField: [ { position: 30 } ]
  ShippingPoint;

  @UI.lineItem: [ { position: 40 } ]
  @UI.selectionField: [ { position: 40 } ]
  Supplier;

  @UI.lineItem: [ { position: 50, importance: #HIGH } ]
  @UI.selectionField: [ { position: 50 } ]
  DeliveryDate;

  @UI.lineItem: [ { position: 60, criticality: 'GoodsMovementStatusCriticality', criticalityRepresentation: #WITH_ICON } ]
  @UI.fieldGroup: [ { qualifier: 'HDSTATUS', position: 20, criticality: 'GoodsMovementStatusCriticality', criticalityRepresentation: #WITH_ICON } ]
  @UI.selectionField: [ { position: 60 } ]
  OverallGoodsMovementStatus;

}